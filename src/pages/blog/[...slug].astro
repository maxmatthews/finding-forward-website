---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const all = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const idx = all.findIndex(p => p.id === post.id);
const prev = all[idx + 1] ?? null;
const next = all[idx - 1] ?? null;

const fmt = (d: Date) => d.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});

const readingTime = (() => {
  const words = post.body?.split(/\s+/).length ?? 0;
  return Math.max(1, Math.round(words / 220));
})();
---
<Layout
  active="notes"
  title={`${post.data.title} — Finding Forward`}
  description={post.data.summary}>

  <article class="post">
    <header class="post__head">
      <div class="wrap post__head-wrap">
        <p class="eyebrow" data-reveal>
          <a href="/blog/" style="border-bottom:1px solid currentColor;padding-bottom:1px;">Practice Notes</a>
        </p>
        <h1 class="display post__h" data-reveal data-reveal-delay="1">{post.data.title}</h1>
        <p class="post__sum" data-reveal data-reveal-delay="2">{post.data.summary}</p>
        <div class="post__meta" data-reveal data-reveal-delay="3">
          <div><span class="mono post__label">Published</span><time>{fmt(post.data.date)}</time></div>
          {post.data.updated && (
            <div><span class="mono post__label">Updated</span><time>{fmt(post.data.updated)}</time></div>
          )}
          <div><span class="mono post__label">Reading</span><span>{readingTime} min</span></div>
          <div><span class="mono post__label">By</span><span>Kevin Roche</span></div>
        </div>
      </div>
    </header>

    {post.data.hero && (
      <figure class="post__hero" data-reveal data-reveal-delay="2">
        <div class="wrap">
          <img src={post.data.hero} alt={post.data.heroAlt || ''}/>
        </div>
      </figure>
    )}

    <div class="post__body wrap">
      <div class="prose">
        <Content />
      </div>

      {post.data.tags.length > 0 && (
        <ul class="post__tags">
          {post.data.tags.map(t => <li class="mono">#{t}</li>)}
        </ul>
      )}
    </div>

    <nav class="post__nav">
      <div class="wrap post__nav-wrap">
        {prev ? (
          <a href={`/blog/${prev.id}/`} class="post__nav-link">
            <span class="mono post__nav-dir">← Earlier</span>
            <span class="display post__nav-title">{prev.data.title}</span>
          </a>
        ) : <div></div>}
        {next ? (
          <a href={`/blog/${next.id}/`} class="post__nav-link post__nav-link--right">
            <span class="mono post__nav-dir">More recent →</span>
            <span class="display post__nav-title">{next.data.title}</span>
          </a>
        ) : <div></div>}
      </div>
    </nav>
  </article>

</Layout>

<style is:global>
  .prose {
    max-width: 68ch;
    margin-inline: auto;
    color: var(--ink);
    font-size: 19px;
    line-height: 1.65;
  }
  .prose > * + * { margin-top: 1.1em; }
  .prose p { max-width: none; }
  .prose p:first-of-type::first-letter {
    font-family: var(--display);
    font-size: 5.2em;
    line-height: 0.86;
    float: left;
    padding: 8px 12px 0 0;
    color: var(--clay);
    font-variation-settings: "opsz" 144, "SOFT" 50;
    font-weight: 380;
  }
  .prose h2 {
    font-family: var(--display);
    font-size: 1.8em;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-top: 2em;
    color: var(--ink);
    font-variation-settings: "opsz" 144, "SOFT" 30;
  }
  .prose h3 {
    font-family: var(--display);
    font-size: 1.4em;
    line-height: 1.2;
    margin-top: 1.6em;
    color: var(--ink);
  }
  .prose a {
    border-bottom: 1px solid var(--clay);
    transition: background 0.3s var(--ease);
  }
  .prose a:hover { background: rgba(195, 107, 71, 0.12); }
  .prose strong { font-weight: 600; color: var(--ink); }
  .prose em { font-style: italic; }
  .prose blockquote {
    margin-block: 1.6em;
    padding: 18px 24px;
    border-left: 2px solid var(--clay);
    background: var(--bone-2);
    font-family: var(--display);
    font-style: italic;
    font-size: 1.1em;
    line-height: 1.4;
    color: var(--ink);
    font-variation-settings: "opsz" 144, "SOFT" 80;
  }
  .prose blockquote p { margin: 0; }
  .prose ul, .prose ol {
    padding-left: 1.4em;
    display: grid;
    gap: 0.4em;
  }
  .prose ul li { list-style: '✶  '; padding-left: 4px; }
  .prose ul li::marker { color: var(--clay); }
  .prose ol li::marker { color: var(--clay); font-family: var(--mono); }
  .prose hr {
    border: 0;
    height: 1px;
    background: var(--line);
    margin-block: 2.4em;
  }
  .prose code {
    background: var(--bone-2);
    padding: 2px 6px;
    border-radius: 3px;
    font-family: var(--mono);
    font-size: 0.85em;
  }
  .prose pre {
    background: var(--ink);
    color: var(--paper);
    padding: 20px 24px;
    border-radius: 4px;
    overflow-x: auto;
    font-family: var(--mono);
    font-size: 0.85em;
  }
  .prose pre code { background: none; padding: 0; }
  .prose img {
    border-radius: 4px;
    margin-block: 1.4em;
  }
</style>

<style>
  .post__head { padding: clamp(56px, 7vw, 100px) 0 clamp(24px, 3vw, 40px); background: var(--bone); }
  .post__head-wrap { display: grid; gap: 22px; max-width: 920px; }
  .post__h {
    font-size: clamp(40px, 5.5vw, 80px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--ink);
  }
  .post__sum {
    font-family: var(--display);
    font-size: clamp(20px, 1.8vw, 26px);
    font-style: italic;
    line-height: 1.4;
    color: var(--ink-2);
    max-width: 60ch;
    font-variation-settings: "opsz" 144, "SOFT" 70;
  }
  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 36px;
    border-top: 1px solid var(--line);
    padding-top: 18px;
    margin-top: 8px;
  }
  .post__meta > div { display: grid; gap: 4px; }
  .post__label { color: var(--ink-2); }
  .post__meta time, .post__meta span:last-child { font-size: 14px; color: var(--ink); }

  .post__hero {
    padding: clamp(20px, 3vw, 32px) 0 clamp(40px, 5vw, 64px);
    background: var(--bone);
  }
  .post__hero img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 4px;
    box-shadow: 0 24px 56px rgba(28,38,32,0.12);
  }

  .post__body { padding: clamp(20px, 3vw, 40px) 0 clamp(56px, 8vw, 100px); }

  .post__tags {
    margin: 3em auto 0;
    max-width: 68ch;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 1.8em;
    border-top: 1px solid var(--line);
  }
  .post__tags li { color: var(--ink-2); font-size: 11px; }

  .post__nav {
    background: var(--bone-2);
    padding: clamp(48px, 6vw, 80px) 0;
    border-top: 1px solid var(--line);
  }
  .post__nav-wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: start;
  }
  .post__nav-link {
    display: grid;
    gap: 10px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--paper);
    transition: transform 0.5s var(--ease), background 0.5s var(--ease);
  }
  .post__nav-link:hover { transform: translateY(-3px); background: var(--bone); }
  .post__nav-link--right { text-align: right; }
  .post__nav-dir { color: var(--clay); font-size: 11px; letter-spacing: 0.14em; }
  .post__nav-title {
    font-size: 22px;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--ink);
    font-variation-settings: "opsz" 144, "SOFT" 40;
  }

  @media (max-width: 700px) {
    .post__nav-wrap { grid-template-columns: 1fr; }
    .post__nav-link--right { text-align: left; }
  }
</style>
