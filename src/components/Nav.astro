---
interface Props { active?: string }
const { active = 'home' } = Astro.props;

const links = [
  { key: 'home',      href: '/',           label: 'Home' },
  { key: 'services',  href: '/services',   label: 'Services' },
  { key: 'about',     href: '/about',      label: 'About' },
  { key: 'notes',     href: '/blog/',      label: 'Notes' },
  { key: 'contact',   href: '/contact',    label: 'Contact' },
];
---
<header class="nav" data-header>
  <div class="nav__inner">
    <a href="/" class="nav__brand" aria-label="Finding Forward home">
      <span class="nav__mark" aria-hidden="true">
        <svg viewBox="0 0 40 40" width="32" height="32">
          <circle cx="20" cy="20" r="19" fill="none" stroke="currentColor" stroke-width="1"/>
          <path d="M11 26 L11 14 L17 14 M11 20 L16 20" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"/>
          <path d="M22 26 L22 14 L28 14 L22 26 Z" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="nav__name">
        <span class="nav__name-top">Finding</span>
        <span class="nav__name-bot italic">forward</span>
      </span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {links.map(l => (
        <a href={l.href} class:list={['nav__link', { 'is-active': active === l.key }]}>{l.label}</a>
      ))}
    </nav>

    <div class="nav__cta">
      <span class="nav__live" aria-hidden="true"><span class="pulse"></span> Accepting clients</span>
      <a href="https://calendly.com/kevinrochelpc/consultation-call" class="btn btn-primary nav__btn" target="_blank" rel="noopener">
        <span>Schedule a consult</span>
        <span class="dot" aria-hidden="true"></span>
      </a>
      <button
        type="button"
        class="nav__toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        data-nav-toggle
      >
        <span class="nav__toggle-bar" aria-hidden="true"></span>
        <span class="nav__toggle-bar" aria-hidden="true"></span>
        <span class="nav__toggle-bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu overlay -->
<div
  id="mobile-menu"
  class="mnav"
  aria-hidden="true"
  data-nav-menu
>
  <div class="mnav__inner">
    <p class="eyebrow mnav__eyebrow">Index — Menu</p>
    <nav class="mnav__links" aria-label="Mobile primary">
      {links.map((l, i) => (
        <a
          href={l.href}
          class:list={['mnav__link', { 'is-active': active === l.key }]}
          style={`--i:${i}`}
        >
          <span class="display mnav__label">{l.label}</span>
          <span class="mono mnav__num">0{i + 1}</span>
        </a>
      ))}
    </nav>
    <div class="mnav__foot">
      <a class="btn btn-primary mnav__cta" href="https://calendly.com/kevinrochelpc/consultation-call" target="_blank" rel="noopener">
        <span>Schedule a consult</span><span class="dot" aria-hidden="true"></span>
      </a>
      <p class="mnav__live"><span class="pulse"></span> Accepting new clients</p>
      <a class="mnav__phone display italic" href="tel:+15712009906">(571) 200&nbsp;–&nbsp;9906</a>
    </div>
  </div>
</div>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 80;
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    background: rgba(241, 235, 221, 0.72);
    border-bottom: 1px solid transparent;
    transition: border-color 0.4s var(--ease), background 0.4s var(--ease);
  }
  .nav.is-scrolled {
    border-bottom-color: var(--line);
    background: rgba(241, 235, 221, 0.88);
  }
  .nav__inner {
    max-width: var(--maxw);
    margin-inline: auto;
    padding: 18px var(--gutter);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 32px;
  }
  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--ink);
  }
  .nav__mark { color: var(--moss); display: grid; place-items: center; }
  .nav__name {
    display: inline-flex;
    flex-direction: column;
    line-height: 0.95;
    font-family: var(--display);
    font-size: 22px;
    letter-spacing: -0.03em;
    font-variation-settings: "opsz" 144, "SOFT" 50;
  }
  .nav__name-bot { font-size: 22px; margin-top: -2px; }
  .nav__links {
    display: flex;
    justify-content: center;
    gap: 32px;
  }
  .nav__link {
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-2);
    position: relative;
    padding: 6px 2px;
    transition: color 0.4s var(--ease);
  }
  .nav__link::after {
    content: '';
    position: absolute;
    left: 0; right: 100%;
    bottom: 0;
    height: 1px;
    background: var(--ink);
    transition: right 0.4s var(--ease);
  }
  .nav__link:hover, .nav__link.is-active { color: var(--ink); }
  .nav__link:hover::after, .nav__link.is-active::after { right: 0; }

  .nav__cta {
    display: inline-flex;
    align-items: center;
    gap: 16px;
  }
  .nav__live {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .nav__btn { padding: 12px 16px 12px 18px; font-size: 13px; }

  /* Hamburger button — hidden on desktop */
  .nav__toggle {
    display: none;
    width: 44px; height: 44px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgba(250, 245, 234, 0.6);
    color: var(--ink);
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 5px;
    transition: background 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .nav__toggle:hover { background: var(--paper); border-color: var(--ink); }
  .nav__toggle-bar {
    display: block;
    width: 18px;
    height: 1.5px;
    background: var(--ink);
    transition: transform 0.4s var(--ease), opacity 0.3s var(--ease), width 0.4s var(--ease);
    transform-origin: center;
  }
  .nav__toggle[aria-expanded="true"] .nav__toggle-bar:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .nav__toggle[aria-expanded="true"] .nav__toggle-bar:nth-child(2) {
    opacity: 0;
    width: 0;
  }
  .nav__toggle[aria-expanded="true"] .nav__toggle-bar:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  @media (max-width: 920px) {
    .nav__links { display: none; }
    .nav__inner { grid-template-columns: auto 1fr; }
    .nav__live { display: none; }
    .nav__toggle { display: flex; }
  }
  @media (max-width: 540px) {
    .nav__btn { display: none; }
  }

  /* Mobile menu overlay ========================== */
  .mnav {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: var(--ink);
    color: var(--paper);
    padding: clamp(80px, 14vw, 120px) var(--gutter) clamp(32px, 6vw, 48px);
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.45s var(--ease), visibility 0s linear 0.45s;
    overflow-y: auto;
  }
  .mnav::before {
    content: '';
    position: absolute;
    top: -10%;
    right: -10%;
    width: 60%;
    height: 60%;
    background: radial-gradient(circle, rgba(195, 107, 71, 0.25), transparent 60%);
    pointer-events: none;
  }
  .mnav.is-open {
    visibility: visible;
    opacity: 1;
    transition: opacity 0.45s var(--ease), visibility 0s;
  }
  .mnav__inner {
    position: relative;
    display: grid;
    gap: clamp(32px, 6vw, 56px);
    max-width: var(--maxw);
    margin-inline: auto;
    min-height: calc(100vh - clamp(112px, 20vw, 168px));
    grid-template-rows: auto 1fr auto;
  }
  .mnav__eyebrow { color: var(--sage); }
  .mnav__eyebrow::before { background: var(--sage); }

  .mnav__links {
    display: grid;
    gap: 0;
    border-top: 1px solid rgba(250, 245, 234, 0.12);
  }
  .mnav__link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: clamp(18px, 3vw, 28px) 0;
    border-bottom: 1px solid rgba(250, 245, 234, 0.12);
    color: var(--paper);
    transition: color 0.3s var(--ease), padding-left 0.4s var(--ease);
    opacity: 0;
    transform: translateY(20px);
  }
  .mnav.is-open .mnav__link {
    animation: mnav-in 0.6s var(--ease) forwards;
    animation-delay: calc(150ms + var(--i) * 70ms);
  }
  @keyframes mnav-in {
    to { opacity: 1; transform: translateY(0); }
  }
  .mnav__link:hover { color: var(--sun); padding-left: 8px; }
  .mnav__link.is-active { color: var(--clay); }
  .mnav__label {
    color: inherit;
    font-size: clamp(40px, 9vw, 72px);
    line-height: 0.95;
    letter-spacing: -0.035em;
    font-variation-settings: "opsz" 144, "SOFT" 40;
  }
  .mnav__link.is-active .mnav__label,
  .mnav__link:hover .mnav__label {
    font-style: italic;
    font-variation-settings: "opsz" 144, "SOFT" 100;
  }
  .mnav__num {
    color: var(--sage);
    font-size: 11px;
    letter-spacing: 0.18em;
  }

  .mnav__foot {
    display: grid;
    gap: 18px;
    padding-top: clamp(28px, 4vw, 40px);
    border-top: 1px solid rgba(250, 245, 234, 0.12);
    justify-items: start;
  }
  .mnav__cta { background: var(--paper); color: var(--ink); }
  .mnav__cta:hover { background: var(--sun); }
  .mnav__live {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: rgba(250, 245, 234, 0.7);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .mnav__phone {
    font-size: clamp(28px, 6vw, 40px);
    color: var(--sun);
    border-bottom: 1px solid rgba(229, 183, 99, 0.3);
    padding-bottom: 2px;
    font-variation-settings: "opsz" 144, "SOFT" 80;
    transition: color 0.3s ease, border-color 0.3s ease;
  }
  .mnav__phone:hover { color: var(--paper); border-color: var(--paper); }

  /* Hide overlay above the breakpoint, no matter what */
  @media (min-width: 921px) {
    .mnav { display: none; }
  }

  /* Prevent body scroll when menu is open */
  :global(body.has-mnav-open) {
    overflow: hidden;
  }
</style>

<script is:inline>
  (function () {
    const toggle = document.querySelector('[data-nav-toggle]');
    const menu = document.querySelector('[data-nav-menu]');
    if (!toggle || !menu) return;

    const setOpen = (open) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.setAttribute('aria-hidden', String(!open));
      menu.classList.toggle('is-open', open);
      document.body.classList.toggle('has-mnav-open', open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Close on link tap
    menu.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => setOpen(false));
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    // Close if the viewport grows past the breakpoint while open
    const mq = window.matchMedia('(min-width: 921px)');
    mq.addEventListener('change', (e) => { if (e.matches) setOpen(false); });
  })();
</script>
